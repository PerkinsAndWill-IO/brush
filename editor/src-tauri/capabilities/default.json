{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Open PDFs/.drawing packages (dialog or drop) read-only; read/write only <name>.brush.json sidecars.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "**/*.pdf"
        },
        {
          "path": "**/*.drawing"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "**/*.brush.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "**/*.brush.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "**/*.brush.json"
        }
      ]
    }
  ]
}